diff --git a/src/components/PageLoader.tsx b/src/components/PageLoader.tsx
new file mode 100644
index 0000000..222a366
--- /dev/null
+++ b/src/components/PageLoader.tsx
@@ -0,0 +1,19 @@
+"use client";
+
+import { useIsNavigating } from "@/lib/navigation";
+
+/** Full-screen spinner shown while a page change is in progress. */
+export function PageLoader() {
+  const navigating = useIsNavigating();
+  if (!navigating) return null;
+
+  return (
+    <div
+      role="status"
+      aria-label="Loading"
+      className="fixed inset-0 z-[100] flex cursor-wait items-center justify-center bg-white"
+    >
+      <span className="size-8 animate-spin rounded-full border-[3px] border-black border-t-transparent motion-reduce:animate-none" />
+    </div>
+  );
+}
